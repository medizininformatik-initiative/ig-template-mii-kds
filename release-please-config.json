{
  "release-type": "simple",
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "package/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "sushi-config.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-list.json",
          "jsonpath": "$.list[0].version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "chore",
      "section": "Toolchain and maintenance"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ]
}

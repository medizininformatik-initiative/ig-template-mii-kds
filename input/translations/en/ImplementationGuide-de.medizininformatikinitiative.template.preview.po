# de -> en
#
# English translations of the preview IG's own fields — breadcrumbs, table-of-
# contents entries and section captions render from
# ImplementationGuide.definition.page.title, so without this file the /en/ pages
# keep the German titles although their content is English. Same mechanism as
# the KDS Dokument module (ImplementationGuide-mii-ig-dokument.po); msgid must
# equal the exact `pages:` title in sushi-config.yaml, character for character.

# ImplementationGuide.title
#: ImplementationGuide.title
msgid "MII-KDS-IG-Vorlage — Vorschau"
msgstr "MII KDS IG Template — Preview"

# ImplementationGuide.definition.page.title
#: ImplementationGuide.definition.page.title
msgid "Inhaltsverzeichnis"
msgstr "Table of Contents"

# ImplementationGuide.definition.page.title
#: ImplementationGuide.definition.page.title
msgid "Startseite"
msgstr "Home"

# ImplementationGuide.definition.page.title
#: ImplementationGuide.definition.page.title
msgid "Hinweise zur Übersetzung"
msgstr "Translation information"

# ImplementationGuide.publisher — the footer's "IG © <year> <publisher>" line.
# "NUM-DIZ" is a proper name and language-neutral (styleguide §6), so the
# English "translation" is identical; the unit stays so the catalogue keeps
# covering every translatable IG field.
#: ImplementationGuide.publisher
msgid "NUM-DIZ"
msgstr "NUM-DIZ"
